@@ -2084,6 +2167,7 @@ static pj_bool_t on_connect_complete(pj_ssl_sock_t *ssock,
         pj_str_t *remote_name;
         pj_ssl_cert_info *serv_cert = ssl_info.remote_cert_info;
         pj_bool_t matched = PJ_FALSE;
+        pj_bool_t wildcard = PJ_FALSE;
         unsigned i;
 
         /* Remote name may be hostname or IP address */
@@ -2100,6 +2184,8 @@ static pj_bool_t on_connect_complete(pj_ssl_sock_t *ssock,
 
             switch (serv_cert->subj_alt_name.entry[i].type) {
             case PJ_SSL_CERT_NAME_DNS:
+                matched = match_cert_name(remote_name, cert_name, &wildcard);
+                break;
             case PJ_SSL_CERT_NAME_IP:
                 matched = !pj_stricmp(remote_name, cert_name);
                 break;
@@ -2125,15 +2211,20 @@ static pj_bool_t on_connect_complete(pj_ssl_sock_t *ssock,
          * certificate, try with Common Name of Subject field.
          */
         if (!matched) {
-            matched = !pj_stricmp(remote_name, &serv_cert->subject.cn);
+            matched = match_cert_name(remote_name, &serv_cert->subject.cn,
+                                      &wildcard);
+        }
+
+        if (matched && wildcard) {
+            PJ_LOG(2,(tls->base.obj_name,
+                "Warning: server '%.*s' was accepted on a TLS wildcard "
+                    "certificate, which RFC 5922 (section 7.2) does not "
+                    "allow for SIP. The RFC 6125 wildcard rules were "
+                    "applied instead. Advise your SIP provider, please!",
+                (int)remote_name->slen, remote_name->ptr));
         }
 
         if (!matched) {
-            if (pj_strnicmp2(&serv_cert->subject.cn, "*.", 2) == 0) {
-                PJ_LOG(1,(tls->base.obj_name,
-                    "RFC 5922 (section 7.2) does not allow TLS wildcard "
-                        "certificates. Advise your SIP provider, please!"));
-            }
             ssl_info.verify_status |= PJ_SSL_CERT_EIDENTITY_NOT_MATCH;
         }
     }
