# Urmet cloud credentials (SDK Settings, prefix URMET_). Never commit real values.
URMET_EMAIL=you@example.com
URMET_PASSWORD=your-urmet-cloud-password
URMET_DOORPHONE_MAC=00:11:22:33:44:55
URMET_DOORPHONE_NAME=Front Gate

# Gateway service settings (prefix URMET_GW_).
URMET_GW_PORT=8099
URMET_GW_LOG_LEVEL=info
